# Copy to .env and adjust. Never commit .env.
PORT=5001
MONGODB_URI=mongodb://127.0.0.1:27017/yatrawise
# Directory for exported itineraries and event logs
EXPORT_DIR=server/exports
LOG_DIR=server/logs
CORS_ORIGIN=http://localhost:5173
# Protects destination writes and listing of trips/messages. Required in production.
# Send as the x-api-key header. Leave blank only for local development.
ADMIN_API_KEY=
